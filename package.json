{
  "name": "warm-window",
  "version": "0.1.0",
  "description": "Find the idle tax on any AI model: what you pay in money or waiting when long conversations go cold after breaks. Works with Claude Code, Codex, open models and any OpenAI, Anthropic or Ollama style API.",
  "type": "module",
  "bin": {
    "warm-window": "bin/warm-window.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "scan": "node bin/warm-window.js scan"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "openai",
    "open-source-models",
    "llama.cpp",
    "ollama",
    "deepseek",
    "qwen",
    "openrouter",
    "anthropic",
    "prompt-caching",
    "cache",
    "compaction",
    "llm",
    "cost",
    "tokens",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shoberman2/warm-window.git"
  },
  "homepage": "https://github.com/Shoberman2/warm-window#readme",
  "bugs": "https://github.com/Shoberman2/warm-window/issues",
  "license": "MIT"
}
